@page
@model wt_lab8_8razor_postgresql_krutalevich.Pages.Flights.IndexModel

@{
    ViewData["Title"] = "Рейсы";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог рейсов</h1>
            <p class="text-muted mb-0">Авиакомпания — система бронирования билетов</p>
        </div>
        <a asp-page="/Flights/Create" class="btn btn-primary">
            + Добавить рейс
        </a>
    </div>

    @if (!Model.Flights.Any())
    {
        <div class="alert alert-info">
            Рейсов пока нет. Добавьте первый рейс.
        </div>
    }
    else
    {
        <form method="get" class="row g-2 mb-4">
            <div class="col-12 col-md-8">
                <input type="text"
                       name="Search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Поиск по номеру рейса, городу вылета или прилёта" />
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Найти</button>
                <a asp-page="/Flights/Index" class="btn btn-outline-secondary">Сбросить</a>
            </div>
        </form>
        <p class="text-muted">Всего рейсов: @Model.Flights.Count</p>

        <div class="row g-4">
            @foreach (var flight in Model.Flights)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary">
                                    ID: @flight.Id
                                </span>
                                @if (flight.IsAvailable)
                                {
                                    <span class="badge bg-success">Доступен</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Нет мест</span>
                                }
                            </div>

                            <h5 class="card-title fw-bold mb-1">
                                @flight.FlightNumber
                            </h5>
                            <p class="text-muted mb-3">
                                @flight.Departure → @flight.Arrival
                            </p>

                            <p class="fs-4 fw-bold text-primary mb-3">
                                @flight.Price.ToString("F2") руб.
                            </p>

                            <a asp-page="/Flights/Details"
                               asp-route-id="@flight.Id"
                               class="btn btn-outline-primary mt-auto">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>