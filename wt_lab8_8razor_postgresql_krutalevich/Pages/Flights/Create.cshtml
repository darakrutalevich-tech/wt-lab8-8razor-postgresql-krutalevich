@page
@model wt_lab8_8razor_postgresql_krutalevich.Pages.Flights.CreateModel

@{
    ViewData["Title"] = "Добавить рейс";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-page="/Flights/Index">Рейсы</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Добавить
                    </li>
                </ol>
            </nav>

            <div class="card shadow-sm rounded-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0 fs-4">Добавление рейса</h2>
                </div>
                <div class="card-body">

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Flight.FlightNumber" class="form-label"></label>
                            <input asp-for="Flight.FlightNumber" class="form-control" />
                            <span asp-validation-for="Flight.FlightNumber"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Flight.Departure" class="form-label"></label>
                            <input asp-for="Flight.Departure" class="form-control" />
                            <span asp-validation-for="Flight.Departure"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Flight.Arrival" class="form-label"></label>
                            <input asp-for="Flight.Arrival" class="form-control" />
                            <span asp-validation-for="Flight.Arrival"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Flight.Price" class="form-label"></label>
                            <input asp-for="Flight.Price"
                                   type="number"
                                   step="0.01"
                                   class="form-control" />
                            <span asp-validation-for="Flight.Price"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Flight.IsAvailable"
                                   class="form-check-input" />
                            <label asp-for="Flight.IsAvailable"
                                   class="form-check-label"></label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="/Flights/Index" class="btn btn-secondary">
                                ← Назад
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Сохранить
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}