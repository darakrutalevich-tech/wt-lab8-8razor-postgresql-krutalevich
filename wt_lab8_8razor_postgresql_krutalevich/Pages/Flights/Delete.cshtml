@page
@model wt_lab8_8razor_postgresql_krutalevich.Pages.Flights.DeleteModel

@{
    ViewData["Title"] = "Удалить рейс";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow-sm rounded-4 border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0 fs-4">Удаление рейса</h2>
                </div>
                <div class="card-body">

                    <p class="fs-5">
                        Вы уверены, что хотите удалить рейс
                        <strong>@Model.Flight?.FlightNumber</strong>
                        (@Model.Flight?.Departure → @Model.Flight?.Arrival)?
                    </p>

                    <dl class="row">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8">@Model.Flight?.Id</dd>

                        <dt class="col-sm-4">Цена</dt>
                        <dd class="col-sm-8">
                            @Model.Flight?.Price.ToString("F2") руб.
                        </dd>

                        <dt class="col-sm-4">Статус</dt>
                        <dd class="col-sm-8">
                            @if (Model.Flight?.IsAvailable == true)
                            {
                                <span class="badge bg-success">Доступен</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Нет мест</span>
                            }
                        </dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" name="id" value="@Model.Flight?.Id" />
                        <div class="d-flex justify-content-between mt-3">
                            <a asp-page="/Flights/Index" class="btn btn-secondary">
                                ← Отмена
                            </a>
                            <button type="submit" class="btn btn-danger">
                                Удалить
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>