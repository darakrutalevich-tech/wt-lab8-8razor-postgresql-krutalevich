@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container py-5">

    <div class="p-5 mb-5 rounded-4 shadow-sm text-white"
         style="background: linear-gradient(135deg, #0d6efd, #6610f2);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold mb-3">✈ Авиакомпания</h1>
                <p class="fs-5 mb-4">
                    Система бронирования билетов на ASP.NET Core Razor Pages:
                    просматривайте рейсы, добавляйте новые направления
                    и управляйте расписанием.
                </p>
                <a asp-page="/Flights/Index" class="btn btn-light btn-lg me-2">
                    Перейти к рейсам
                </a>
                <a asp-page="/Flights/Create" class="btn btn-outline-light btn-lg">
                    Добавить рейс
                </a>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <div style="font-size: 8rem;">✈</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm rounded-4 border-0">
                <div class="card-body text-center">
                    <div class="fs-1 mb-2">🌍</div>
                    <h5 class="card-title">Разные направления</h5>
                    <p class="card-text text-muted mb-0">
                        Минск, Варшава, Берлин, Париж, Прага и другие города.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm rounded-4 border-0">
                <div class="card-body text-center">
                    <div class="fs-1 mb-2">💰</div>
                    <h5 class="card-title">Прозрачные цены</h5>
                    <p class="card-text text-muted mb-0">
                        Стоимость каждого рейса указана сразу, без скрытых платежей.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm rounded-4 border-0">
                <div class="card-body text-center">
                    <div class="fs-1 mb-2">⚡</div>
                    <h5 class="card-title">Быстрое управление</h5>
                    <p class="card-text text-muted mb-0">
                        Добавление, редактирование и удаление рейсов — за пару кликов.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <h3 class="fw-bold mb-3">Готовы выбрать рейс?</h3>
        <p class="text-muted mb-4">
            Откройте каталог — там доступные направления и цены!
        </p>
        <a asp-page="/Flights/Index" class="btn btn-primary btn-lg">
            Смотреть все рейсы →
        </a>
    </div>

</div>